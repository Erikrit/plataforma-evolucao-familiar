# Copiar para /opt/pef-homolog/.env (não versionar valores reais).
# Exemplos sem credenciais de produção.

# Imagens no GHCR (mesmo SHA nas duas)
PEF_IMAGE_REGISTRY=ghcr.io/erikrit/plataforma-evolucao-familiar
PEF_IMAGE_SHA=SUBSTITUA_PELO_SHA_COMPLETO_DO_COMMIT

# PostgreSQL (somente rede interna do Compose; sem porta no host)
POSTGRES_USER=pef_homolog
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=pef_homolog

# Origem da UI vista pelo navegador (CORS + cookie). Com proxy HTTPS use a URL pública.
WEB_ORIGIN=https://homolog.exemplo.com
# Em HTTPS de homologação: true. Em ensaio local só em 127.0.0.1: false.
COOKIE_SECURE=true

PEF_INCREMENTO=homolog

# Portas no host (sempre vinculadas a 127.0.0.1). Padrão 3001/3000.
PEF_API_HOST_PORT=3001
PEF_WEB_HOST_PORT=3000

# --- Build da imagem web (GitHub Actions / docker build) ---
# URL que o NAVEGADOR usa para chamar a API (embutida no bundle Next).
# Não use http://api:3001 (hostname interno Docker).
# NEXT_PUBLIC_API_URL=https://api-homolog.exemplo.com
