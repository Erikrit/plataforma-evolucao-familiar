{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/bloquear-shell.mjs",
        "failClosed": true,
        "timeout": 15
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "node .cursor/hooks/bloquear-mcp.mjs",
        "failClosed": true,
        "timeout": 15
      }
    ],
    "preToolUse": [
      {
        "command": "node .cursor/hooks/bloquear-pretool.mjs",
        "failClosed": true,
        "timeout": 15
      }
    ]
  }
}
